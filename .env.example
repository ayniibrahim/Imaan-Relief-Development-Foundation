# Environment Configuration for Imaan Relief & Development Foundation

# Port & URLs
PORT=3000
NODE_ENV=development
APP_URL="MY_APP_URL"
CLIENT_URL="http://localhost:3000"
VITE_API_URL="/api"

# MongoDB Database Connection
# When set, the system connects directly to MongoDB / MongoDB Atlas.
# If unset or connecting locally, the application automatically uses high-performance embedded storage.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/imaan_relief?retryWrites=true&w=majority"

# JWT Authentication
JWT_SECRET="imaan-relief-super-secret-jwt-key-2025"
JWT_EXPIRES_IN="7d"

# Cloudinary Image Management (Production Image CDN)
# Provide credentials below for direct Cloudinary cloud storage, or leave empty to use local secure upload storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Gemini API Key (Server-side AI capability)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
